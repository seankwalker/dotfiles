#!/usr/bin/env bash
set -e

usage() {
  cat <<EOF
usage:
  ${0##*/} add  [-t|--tmux] [-z|--zed] <branch> [start-point]
  ${0##*/} guidance [worktree-path]
  ${0##*/} path <branch>
  ${0##*/} open [-t|--tmux] [-z|--zed] <branch> [branch ...]
  ${0##*/} rm   [-f|--force] [-d] <branch> [branch ...]

env:
  WORKTREES_BASE   (default: \$HOME/Developer/mono-worktrees)
  AGENTS_OVERRIDE_TEMPLATE   (default: \$HOME/bin/templates/monorepo-agents-override.md)

notes:
  - worktree dir name is branch with '/' replaced by '-'
  - add: creates a worktree without opening it by default
  - add --tmux: opens the new worktree in a detached tmux window
  - add --zed: opens the new worktree with 'zed <path>'
  - guidance: regenerates a personal AGENTS.override.md when the repo uses cascade
  - path: prints the registered filesystem path for a branch's worktree
  - open --zed: opens existing worktrees with 'zed <path>'
  - open --tmux: opens detached tmux windows with Codex resume on the left and a shell on the right
  - open: defaults to --tmux for backward compatibility; --zed and --tmux may be combined
  - rm: flags apply to every branch; -f/--force = force-remove, -d = delete local branch
EOF
  exit 1
}

WORKTREES_BASE="${WORKTREES_BASE:-$HOME/Developer/mono-worktrees}"
AGENTS_OVERRIDE_TEMPLATE="${AGENTS_OVERRIDE_TEMPLATE:-$HOME/bin/templates/monorepo-agents-override.md}"

sanitize_branch() {
  # Option B: flatten slashes
  echo "${1//\//-}"
}

worktree_path_for_branch() {
  local branch="$1"
  local target_ref="refs/heads/$branch"
  local worktree=""
  local ref=""

  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      "worktree "*) worktree="${line#worktree }" ;;
      "branch "*)
        ref="${line#branch }"
        if [[ "$ref" == "$target_ref" ]]; then
          printf '%s\n' "$worktree"
          return 0
        fi
        ;;
      "") worktree=""; ref="" ;;
    esac
  done < <(git worktree list --porcelain)

  return 1
}

ensure_in_git_repo() {
  git rev-parse --show-toplevel >/dev/null 2>&1 || {
    echo "error: not inside a git repo"
    exit 1
  }
}

generate_personal_agents_override() {
  local target_dir="$1"
  local base_file="$target_dir/AGENTS.md"
  local override_file="$target_dir/AGENTS.override.md"
  local exclude_file=""
  local tmp_file=""

  [[ -f "$base_file" ]] || return 0
  grep -Fxq '## Delegation (cascade)' "$base_file" || return 0
  [[ -f "$AGENTS_OVERRIDE_TEMPLATE" ]] || {
    echo "error: AGENTS override template not found: $AGENTS_OVERRIDE_TEMPLATE" >&2
    return 1
  }

  exclude_file="$(git -C "$target_dir" rev-parse --git-path info/exclude)"
  if [[ "$exclude_file" != /* ]]; then
    exclude_file="$target_dir/$exclude_file"
  fi
  if ! grep -Fxq '/AGENTS.override.md' "$exclude_file"; then
    printf '\n/AGENTS.override.md\n' >> "$exclude_file"
  fi

  tmp_file="$(mktemp "$target_dir/.AGENTS.override.md.XXXXXX")"
  {
    head -n 1 "$base_file"
    printf '\n'
    cat "$AGENTS_OVERRIDE_TEMPLATE"
    awk '
      NR == 1 { next }
      /^## Delegation \(cascade\)[[:space:]]*$/ { skipping = 1; next }
      skipping && /^## / { skipping = 0 }
      !skipping { print }
    ' "$base_file"
  } > "$tmp_file"
  mv "$tmp_file" "$override_file"
}

open_tmux_window() {
  local dir="$1"
  local name="$2"

  # Only do this when the script is run inside tmux.
  [[ -n "${TMUX:-}" ]] || {
    echo "error: not inside tmux"
    exit 1
  }

  command -v tmux >/dev/null 2>&1 || {
    echo "error: tmux not found"
    exit 1
  }

  # -d creates the window without focusing/selecting it.
  # -c starts the shell in the given directory.
  if tmux new-window -d -c "$dir" -n "$name" 2>/dev/null; then
    return 0
  fi

  # Fallback for older tmux versions without -c support.
  tmux new-window -d -n "$name" "cd \"${dir}\" && exec \"${SHELL:-/bin/bash}\""
}

open_zed_worktree() {
  local dir="$1"

  command -v zed >/dev/null 2>&1 || {
    echo "error: zed not found"
    exit 1
  }

  zed "$dir"
}

open_tmux_resume_window() {
  local dir="$1"
  local name="$2"
  local left_pane=""

  # Only do this when the script is run inside tmux.
  [[ -n "${TMUX:-}" ]] || {
    echo "error: not inside tmux"
    exit 1
  }

  command -v tmux >/dev/null 2>&1 || {
    echo "error: tmux not found"
    exit 1
  }

  # A vertical divider is a horizontal tmux split. Both panes start in the
  # worktree; the left opens Codex's cwd-filtered resume picker.
  if ! left_pane="$(tmux new-window -d -P -F '#{pane_id}' -c "$dir" -n "$name")"; then
    echo "error: failed to create tmux window for $dir" >&2
    exit 1
  fi

  if ! tmux split-window -d -h -p 50 -t "$left_pane" -c "$dir"; then
    echo "error: failed to split tmux window for $dir" >&2
    exit 1
  fi

  tmux send-keys -t "$left_pane" 'codex resume' C-m
  tmux select-pane -t "$left_pane"
}

cmd="${1:-}"
shift || true

case "$cmd" in
  add)
    ensure_in_git_repo

    OPEN_TMUX=0
    OPEN_ZED=0

    while [[ $# -gt 0 ]]; do
      case "$1" in
        -t|--tmux)
          OPEN_TMUX=1
          ;;
        -z|--zed)
          OPEN_ZED=1
          ;;
        --no-open)
          # Backward-compatible no-op now that opening is opt-in.
          ;;
        --)
          shift
          break
          ;;
        -*)
          usage
          ;;
        *)
          break
          ;;
      esac
      shift
    done

    if [[ $# -lt 1 || $# -gt 2 ]]; then usage; fi
    BRANCH="$1"
    START="${2:-main}"

    SAFE_BRANCH="$(sanitize_branch "$BRANCH")"
    DEST="${WORKTREES_BASE}/${SAFE_BRANCH}"

    mkdir -p "$WORKTREES_BASE"

    if EXISTING_PATH="$(worktree_path_for_branch "$BRANCH")"; then
      echo "error: branch already has a worktree: $EXISTING_PATH"
      exit 1
    fi

    # Don't clobber
    if [[ -e "$DEST" ]]; then
      echo "error: destination already exists: $DEST"
      exit 1
    fi

    # Run from a repo worktree root (works from anywhere)
    REPO_ROOT="$(git rev-parse --show-toplevel)"
    cd "$REPO_ROOT"

    set -x
    if git show-ref --verify --quiet "refs/heads/$BRANCH"; then
      git worktree add "$DEST" "$BRANCH"
    else
      git worktree add -b "$BRANCH" "$DEST" "$START"
    fi
    set +x

    generate_personal_agents_override "$DEST"

    printf '%s\n' "$DEST"
    if [[ "$OPEN_TMUX" -eq 1 ]]; then
      open_tmux_window "$DEST" "$SAFE_BRANCH"
    fi
    if [[ "$OPEN_ZED" -eq 1 ]]; then
      open_zed_worktree "$DEST"
    fi
    ;;

  guidance)
    if [[ $# -gt 1 ]]; then usage; fi

    if [[ $# -eq 1 ]]; then
      DEST="$1"
      [[ -d "$DEST" ]] || {
        echo "error: worktree path does not exist: $DEST"
        exit 1
      }
      DEST="$(git -C "$DEST" rev-parse --show-toplevel)"
    else
      ensure_in_git_repo
      DEST="$(git rev-parse --show-toplevel)"
    fi

    generate_personal_agents_override "$DEST"
    printf '%s\n' "$DEST/AGENTS.override.md"
    ;;

  path)
    ensure_in_git_repo
    if [[ $# -ne 1 ]]; then usage; fi

    if ! worktree_path_for_branch "$1"; then
      echo "error: branch does not have a worktree: $1" >&2
      exit 1
    fi
    ;;

  open)
    OPEN_ZED=0
    OPEN_TMUX=0

    while [[ $# -gt 0 ]]; do
      case "$1" in
        -t|--tmux)
          OPEN_TMUX=1
          ;;
        -z|--zed)
          OPEN_ZED=1
          ;;
        --)
          shift
          break
          ;;
        -*)
          usage
          ;;
        *)
          break
          ;;
      esac
      shift
    done

    if [[ $# -lt 1 ]]; then usage; fi
    BRANCHES=("$@")

    if [[ "$OPEN_ZED" -eq 0 && "$OPEN_TMUX" -eq 0 ]]; then
      OPEN_TMUX=1
    fi

    # Validate every path first so a bad argument does not leave only some of
    # the requested windows open.
    for BRANCH in "${BRANCHES[@]}"; do
      SAFE_BRANCH="$(sanitize_branch "$BRANCH")"
      DEST="${WORKTREES_BASE}/${SAFE_BRANCH}"

      if [[ ! -d "$DEST" ]]; then
        echo "error: worktree path does not exist: $DEST"
        exit 1
      fi
    done

    for BRANCH in "${BRANCHES[@]}"; do
      SAFE_BRANCH="$(sanitize_branch "$BRANCH")"
      DEST="${WORKTREES_BASE}/${SAFE_BRANCH}"
      if [[ "$OPEN_ZED" -eq 1 ]]; then
        open_zed_worktree "$DEST"
      fi
      if [[ "$OPEN_TMUX" -eq 1 ]]; then
        open_tmux_resume_window "$DEST" "$SAFE_BRANCH"
      fi
    done
    ;;

  rm|remove|del|delete)
    ensure_in_git_repo

    FORCE=0
    DELETE_BRANCH=0

    while [[ $# -gt 0 ]]; do
      case "$1" in
        -f|--force)
          FORCE=1
          ;;
        -d)
          DELETE_BRANCH=1
          ;;
        -fd|-df)
          FORCE=1
          DELETE_BRANCH=1
          ;;
        --)
          shift
          break
          ;;
        -*)
          usage
          ;;
        *)
          break
          ;;
      esac
      shift
    done

    if [[ $# -lt 1 ]]; then usage; fi
    BRANCHES=("$@")

    # Validate every target first so one bad argument does not leave only part
    # of the requested batch removed.
    HERE="$(git rev-parse --show-toplevel)"
    SEEN_BRANCHES=$'\n'
    for BRANCH in "${BRANCHES[@]}"; do
      if [[ "$SEEN_BRANCHES" == *$'\n'"$BRANCH"$'\n'* ]]; then
        echo "error: duplicate branch: $BRANCH"
        exit 1
      fi
      SEEN_BRANCHES+="$BRANCH"$'\n'

      SAFE_BRANCH="$(sanitize_branch "$BRANCH")"
      DEST="${WORKTREES_BASE}/${SAFE_BRANCH}"

      if [[ ! -e "$DEST" ]]; then
        echo "error: worktree path does not exist: $DEST"
        exit 1
      fi

      # Prevent "remove the worktree you're standing in".
      if [[ "$(cd "$DEST" 2>/dev/null && pwd -P)" == "$(cd "$HERE" && pwd -P)" ]]; then
        echo "error: refusing to remove the current worktree: $DEST"
        exit 1
      fi
    done

    REPO_ROOT="$(git rev-parse --show-toplevel)"
    cd "$REPO_ROOT"

    set -x
    for BRANCH in "${BRANCHES[@]}"; do
      SAFE_BRANCH="$(sanitize_branch "$BRANCH")"
      DEST="${WORKTREES_BASE}/${SAFE_BRANCH}"

      if [[ "$FORCE" -eq 1 ]]; then
        git worktree remove --force "$DEST"
      else
        git worktree remove "$DEST"
      fi

      if [[ "$DELETE_BRANCH" -eq 1 ]]; then
        if git show-ref --verify --quiet "refs/heads/$BRANCH"; then
          git branch -D "$BRANCH"
        fi
      fi
    done

    git worktree prune
    ;;

  *)
    usage
    ;;
esac
