<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>Elflord SKW Ariake</string>
	<key>author</key>
	<string>Sean; adapted from local elflord_skw and Ariake themes</string>
	<key>comment</key>
	<string>Vim cterm highlight groups resolved through the Ghostty Ariake palette. TextMate scopes approximate Vim syntax groups. Added/deleted line colors use Ariake teal/magenta.</string>
	<key>settings</key>
	<array>
		<dict>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#F5FAFF</string>
				<key>background</key>
				<string>#2A2B30</string>
				<key>caret</key>
				<string>#F5FAFF</string>
				<key>selection</key>
				<string>#3D4255</string>
				<key>lineHighlight</key>
				<string>#30333E</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Comment</string>
			<key>scope</key>
			<string>comment</string>
			<key>settings</key>
			<dict>
				<key>fontStyle</key>
				<string></string>
				<key>foreground</key>
				<string>#93DDFB</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Constant</string>
			<key>scope</key>
			<string>constant, string</string>
			<key>settings</key>
			<dict>
				<key>fontStyle</key>
				<string></string>
				<key>foreground</key>
				<string>#DDA2F6</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Special</string>
			<key>scope</key>
			<string>constant.character.escape, constant.other.placeholder, punctuation.definition, entity.name.tag</string>
			<key>settings</key>
			<dict>
				<key>fontStyle</key>
				<string></string>
				<key>foreground</key>
				<string>#A571F4</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Identifier</string>
			<key>scope</key>
			<string>variable</string>
			<key>settings</key>
			<dict>
				<key>fontStyle</key>
				<string>bold</string>
				<key>foreground</key>
				<string>#29C2FF</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Statement</string>
			<key>scope</key>
			<string>keyword, storage.modifier</string>
