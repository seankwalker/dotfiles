			<dict>
				<key>fontStyle</key>
				<string></string>
				<key>foreground</key>
				<string>#D9E1FF</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>PreProc</string>
			<key>scope</key>
			<string>meta.preprocessor, keyword.control.import, keyword.control.include, keyword.other.import, entity.name.function.preprocessor</string>
