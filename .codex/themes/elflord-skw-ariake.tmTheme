			<dict>
				<key>fontStyle</key>
				<string></string>
				<key>foreground</key>
				<string>#D9E1FF</string>
				<key>background</key>
				<string>#4B8ACB</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Todo</string>
			<key>scope</key>
			<string>comment keyword.other.todo</string>
			<key>settings</key>
			<dict>
				<key>fontStyle</key>
				<string></string>
				<key>foreground</key>
				<string>#2A2D37</string>
				<key>background</key>
				<string>#8E8ECC</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Added lines</string>
			<key>scope</key>
			<string>markup.inserted</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#22CEC6</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Removed lines</string>
			<key>scope</key>
			<string>markup.deleted</string>
