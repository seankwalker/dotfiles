				<key>fontStyle</key>
				<string></string>
				<key>foreground</key>
				<string>#8E8ECC</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Repeat</string>
			<key>scope</key>
			<string>keyword.control.conditional, keyword.control.loop</string>
